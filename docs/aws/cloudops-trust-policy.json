{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Sid":  "AllowCloudOpsInsightAssumeRoleExample",
                          "Effect":  "Allow",
                          "Principal":  {
                                            "AWS":  "arn:aws:iam::123456789012:role/REPLACE_WITH_CLOUDOPS_PLATFORM_PRINCIPAL"
                                        },
                          "Action":  "sts:AssumeRole",
                          "Condition":  {
                                            "StringEquals":  {
                                                                 "sts:ExternalId":  "REPLACE_WITH_EXTERNAL_ID_GENERATED_FOR_THIS_INTEGRATION"
                                                             }
                                        }
                      }
                  ]
}
