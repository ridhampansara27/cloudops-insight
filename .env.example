# General application configuration
APP_NAME=CloudOps Insight
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://cloudops:change-me@localhost:5432/cloudops

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS development configuration
AWS_REGION=eu-central-1
AWS_PROFILE=default
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

# Cost synchronization
COST_SYNC_ENABLED=false
COST_SYNC_INTERVAL_HOURS=24

# Monitoring synchronization
RESOURCE_SYNC_ENABLED=false
RESOURCE_SYNC_INTERVAL_MINUTES=15
METRICS_SYNC_ENABLED=false
METRICS_SYNC_INTERVAL_MINUTES=15




