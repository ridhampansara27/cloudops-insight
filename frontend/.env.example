# Define frontend environment variables without any secret values.
$frontendEnvironment = @'
# Browser-visible application name.
VITE_APP_NAME=CloudOps Insight

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Server-sent events endpoint.
VITE_EVENTS_URL=http://localhost:8000/api/v1/events

# Enable local mock data while the backend is not ready.
VITE_ENABLE_MOCKS=true

# Display environment name in the interface.
VITE_APP_ENV=development
'@

# Write the frontend environment template.
Set-Content `
    -Path ".env.example" `
    -Value $frontendEnvironment `
    -Encoding UTF8