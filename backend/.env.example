# Configure the visible FastAPI application name.
APP_NAME=CloudOps Insight API

# Identify the running application environment.
APP_ENV=development

# Enable additional development diagnostics.
DEBUG=true

# Define the API version prefix.
API_V1_PREFIX=/api/v1

# Define the frontend origins permitted by CORS.
CORS_ORIGINS=http://localhost:5173

# Configure the asynchronous PostgreSQL connection.
DATABASE_URL=postgresql+asyncpg://cloudops:cloudops_local_password@localhost:5432/cloudops

# Configure Redis database zero for application caching.
REDIS_URL=redis://localhost:6379/0

# Configure application logging.
LOG_LEVEL=INFO

# Disable SQL statement logging by default.
SQL_ECHO=false