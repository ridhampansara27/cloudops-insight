# Configure the visible FastAPI application name.
APP_NAME=CloudOps Insight API

# Identify the running application environment.
APP_ENV=development

# Enable additional development diagnostics.
DEBUG=true

# Define the API version prefix.
API_V1_PREFIX=/api/v1

# Define the frontend origins permitted by CORS.
CORS_ORIGINS=http://localhost:5173

# Configure the asynchronous PostgreSQL connection.
DATABASE_URL=postgresql+asyncpg://cloudops:cloudops_local_password@localhost:5432/cloudops

# Configure Redis database zero for application caching.
REDIS_URL=redis://localhost:6379/0

# Configure application logging.
LOG_LEVEL=INFO

# Disable SQL statement logging by default.
SQL_ECHO=false






# Configure JWT signing.
JWT_SECRET=replace-with-a-long-random-secret

# Use HMAC SHA-256 for development JWT tokens.
JWT_ALGORITHM=HS256

# Expire access tokens after thirty minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configure the initial local demonstration administrator.
SEED_ADMIN_EMAIL=admin@example.com

# Configure the administrator's display name.
SEED_ADMIN_NAME=CloudOps Administrator

# Never use this example password in a real environment.
SEED_ADMIN_PASSWORD=change-me




# Define the default AWS region used by STS and global AWS operations.
AWS_DEFAULT_REGION=eu-central-1

# Optionally select a local AWS CLI/Boto3 profile.
# Leave empty in container/Kubernetes environments.
AWS_PROFILE_NAME=

# Define the readable STS role-session name.
AWS_ROLE_SESSION_NAME=cloudops-insight

# Limit AssumeRole temporary credentials to one hour.
AWS_ROLE_DURATION_SECONDS=3600



# Use a dedicated Redis logical database for Celery messages.
CELERY_BROKER_URL=redis://localhost:6379/1

# Use another logical database for task results.
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# ============================================================
# Commercial authentication and email delivery
# ============================================================

# Keep public self-service registration disabled until the production
# SMTP provider, DNS authentication and monitoring are verified.
PUBLIC_SIGNUP_ENABLED=false

# Browser origin used to build verification/reset/invitation links.
FRONTEND_BASE_URL=http://localhost:5173

# SMTP settings.
#
# Local Mailpit/MailHog may use an unauthenticated host during development.
# Production validation requires authenticated STARTTLS SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Dedicated HMAC secret for opaque verification/reset/invitation/refresh
# bearers. Production requires this to be different from JWT_SECRET.
AUTH_TOKEN_PEPPER=replace-with-a-different-long-random-development-secret

# Refresh-session cookie.
#
# Local HTTP development may set SECURE=false.
# Production validation requires SECURE=true.
REFRESH_COOKIE_NAME=cloudops_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_DOMAIN=

# Distributed authentication abuse protection.
RATE_LIMIT_ENABLED=true

# Leave disabled until the production backend origin is confirmed to be
# unreachable except through Cloudflare.
RATE_LIMIT_TRUST_CLOUDFLARE_CONNECTING_IP=false
