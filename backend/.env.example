# Configure the visible FastAPI application name.
APP_NAME=CloudOps Insight API

# Identify the running application environment.
APP_ENV=development

# Enable additional development diagnostics.
DEBUG=true

# Define the API version prefix.
API_V1_PREFIX=/api/v1

# Define the frontend origins permitted by CORS.
CORS_ORIGINS=http://localhost:5173

# Configure the asynchronous PostgreSQL connection.
DATABASE_URL=postgresql+asyncpg://cloudops:cloudops_local_password@localhost:5432/cloudops

# Configure Redis database zero for application caching.
REDIS_URL=redis://localhost:6379/0

# Configure application logging.
LOG_LEVEL=INFO

# Disable SQL statement logging by default.
SQL_ECHO=false






# Configure JWT signing.
JWT_SECRET=replace-with-a-long-random-secret

# Use HMAC SHA-256 for development JWT tokens.
JWT_ALGORITHM=HS256

# Expire access tokens after thirty minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configure the initial local demonstration administrator.
SEED_ADMIN_EMAIL=admin@example.com

# Configure the administrator's display name.
SEED_ADMIN_NAME=CloudOps Administrator

# Never use this example password in a real environment.
SEED_ADMIN_PASSWORD=change-me




# Define the default AWS region used by STS and global AWS operations.
AWS_DEFAULT_REGION=eu-central-1

# Optionally select a local AWS CLI/Boto3 profile.
# Leave empty in container/Kubernetes environments.
AWS_PROFILE_NAME=

# Define the readable STS role-session name.
AWS_ROLE_SESSION_NAME=cloudops-insight

# Limit AssumeRole temporary credentials to one hour.
AWS_ROLE_DURATION_SECONDS=3600



# Use a dedicated Redis logical database for Celery messages.
CELERY_BROKER_URL=redis://localhost:6379/1

# Use another logical database for task results.
CELERY_RESULT_BACKEND=redis://localhost:6379/2